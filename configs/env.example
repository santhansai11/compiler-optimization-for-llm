# Environment settings read by the code. Copy to .env and `source .env` (or export them) before running.
# All are optional; the paper's results used the defaults (none set).

# Python interpreter used by run.sh to create .venv
PYTHON=python3.12

# Threading. Leave unset for library defaults (as in the paper), or pin for steadier timings.
# OMP_NUM_THREADS=1
# XLA_FLAGS="--xla_cpu_multi_thread_eigen=false intra_op_parallelism_threads=1"   # same as --single-thread

# Cost model used by the pass pipeline: unset = calibrated table, "legacy" = original hand-written table
# COST_MODEL=legacy

# Print attention-pattern matching details from passes/canonicalize.py
# MATCH_DEBUG=1
